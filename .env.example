# Copy to .env and fill it in: `cp .env.example .env`

# Port the game is published on (http://localhost:8080 by default).
APP_PORT=8080

# Database passwords. Pick long random values; they are only used inside the compose network.
POSTGRES_PASSWORD=
MONGO_PASSWORD=

# The first administrator, created at start-up if it does not exist yet.
# Leave both empty to create it later with:
#   docker compose exec app python -m src create-admin --email you@example.com --password ...
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Behind HTTPS (your own reverse proxy), set COOKIE_SECURE=true so the login cookie is only
# sent over HTTPS, and TRUST_PROXY=true so the real client address and scheme are used.
COOKIE_SECURE=false
TRUST_PROXY=false

# Extra origins allowed to make state-changing requests (comma separated). Normally empty:
# the web client and the API share one origin.
ALLOWED_ORIGINS=

# Set to false to stop new people from signing up (admins can still create accounts).
REGISTRATION_ENABLED=true

# Days a login stays valid.
SESSION_DAYS=14

# Friends: the most friends an account can have, and how many sent requests can wait for an
# answer at the same time.
MAX_FRIENDS=20
MAX_PENDING_REQUESTS=5

# Flash client version to load from ./flash
GAME_SWF=Base_sec_0.6.7c.swf

LOG_LEVEL=INFO
